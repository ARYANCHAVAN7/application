<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20205FAE">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chat_chip_background" />
            <stroke
                android:width="1dp"
                android:color="@color/chat_chip_stroke" />
            <corners android:radius="20dp" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
