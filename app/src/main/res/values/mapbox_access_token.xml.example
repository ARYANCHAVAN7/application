<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to mapbox_access_token.xml (same folder) and replace the
  placeholder with your Mapbox public access token (starts with "pk.").

  Get a token from: https://account.mapbox.com/access-tokens/

  The real mapbox_access_token.xml file is git-ignored and must never be
  committed with a real token.
-->
<resources>
    <string name="mapbox_access_token" translatable="false">pk.your_mapbox_public_token_here</string>
</resources>
